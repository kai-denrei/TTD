{
  "name": "ttd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Tank Tower Defense — a tower-defense/tank hybrid on a Stalberg quad-grid sphere.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "serve": "python3 -m http.server 8144 --directory dist",
    "sweep": "node --experimental-strip-types scripts/sweep.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
